{
    "addr": ":8080",
    "token": "your-auth-token-here",
    "music": {
        "rpc": {
            "address": "alisten-musicd:9090",
            "http_url": "http://alisten-musicd:8081",
            "timeout_seconds": 210
        }
    },
    "debug": true,
    "pgsql": "host=localhost user=postgres password=your-password dbname=alisten port=5432 sslmode=disable",
    "persist": [
        {
            "id": "room",
            "name": "音乐房间",
            "desc": "这是一个持久化的音乐房间",
            "password": ""
        }
    ]
}
