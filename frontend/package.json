{
  "name": "alisten-room",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "nsh run App.tsx --target web",
    "build": "node scripts/build-web.mjs",
    "build:cloudflare": "npm run build",
    "build:android": "python android/build.py",
    "preview": "vite preview --host 127.0.0.1",
    "type-check": "tsc --noEmit",
    "lint": "eslint src App.tsx host.js scripts cloudflare/sw.js",
    "lint:fix": "eslint --fix src App.tsx host.js scripts cloudflare/sw.js"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "music-metadata": "^12.3.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.16.1",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20.10.0",
    "eslint": "^9.29.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
